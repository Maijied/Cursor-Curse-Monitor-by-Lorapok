{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:polling": "CHOKIDAR_USEPOLLING=1 vite",
    "prebuild": "node ../../scripts/generate-site-data.mjs && node ../../scripts/generate-seo.mjs && node ../../scripts/embed-product-context.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && node scripts/lib/mail-credentials.test.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=cursor-monitor-admin",
    "site:data": "node ../../scripts/generate-site-data.mjs",
    "verify:marketplace": "node ../../scripts/verify-marketplace-sync.mjs --strict"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.17.1",
    "framer-motion": "^13.1.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
