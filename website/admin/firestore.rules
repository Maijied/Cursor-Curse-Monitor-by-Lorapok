rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return isSignedIn() && request.auth.token.email == 'mdshuvo40@gmail.com';
    }

    match /admins/{adminId} {
      allow read: if isMaster() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create, update, delete: if isMaster();
    }

    // Visitor counters moved to ADMIN_KV via /api/analytics/visit.
    // Keep doc readable for legacy admin UI; block all client writes.
    match /stats/visitors {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
