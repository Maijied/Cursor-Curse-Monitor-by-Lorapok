{
  "description": "Canonical GitHub label taxonomy for Cursor Curse Monitor. Sync: node scripts/sync-github-labels.mjs",
  "labels": [
    { "name": "type:epic", "color": "6f42c1", "description": "Parent or section epic (groups sub-issues)" },
    { "name": "type:task", "color": "1d76db", "description": "Single master-registry task (AUTH-13, MAIL-13, …)" },
    { "name": "mission-control", "color": "0e8a16", "description": "Mission Control admin panel / operator work" },
    { "name": "priority:p0", "color": "b60205", "description": "P0 — top of recommended queue; do next" },
    { "name": "priority:p1", "color": "d93f0b", "description": "P1 — high priority backlog" },
    { "name": "priority:p2", "color": "fbca04", "description": "P2 — normal backlog" },
    { "name": "status:partial", "color": "c5def5", "description": "Started but not complete (master registry partial)" },
    { "name": "status:deferred", "color": "ededed", "description": "Deferred / wontfix until explicitly revived" },
    { "name": "area:admin", "color": "5319e7", "description": "Mission Control SPA (website/admin)" },
    { "name": "area:auth", "color": "e99695", "description": "Firebase auth, RBAC, ACL, team" },
    { "name": "area:mail", "color": "006b75", "description": "Resend, Cloudflare Email, subscribers" },
    { "name": "area:discord", "color": "5865f2", "description": "Discord webhooks and embed cards" },
    { "name": "area:infra", "color": "f9d0c4", "description": "Cloudflare KV/R2/D1/Pages/Workers" },
    { "name": "area:extension", "color": "bfdadc", "description": "IDE (VS Code) and browser extensions" },
    { "name": "area:website", "color": "c2e0c6", "description": "Marketing site (website/)" },
    { "name": "area:analytics", "color": "fef2c0", "description": "Stats, cron, service analytics hub" },
    { "name": "area:logs", "color": "d4c5f9", "description": "Unified logs explorer, audit trails" },
    { "name": "component:admin", "color": "5319e7", "description": "Alias for procedure-init --component admin" },
    { "name": "component:extension", "color": "bfdadc", "description": "IDE extension (repo root)" },
    { "name": "component:browser", "color": "bfd4f2", "description": "browser-extension/" },
    { "name": "component:website", "color": "c2e0c6", "description": "website/ marketing" },
    { "name": "good first issue", "color": "7057ff", "description": "Suitable for new contributors" },
    { "name": "help wanted", "color": "008672", "description": "Extra attention or partial completion welcome" },
    { "name": "documentation", "color": "0075ca", "description": "Docs, wiki, TASK-TRACKING, guides" },
    { "name": "enhancement", "color": "a2eeef", "description": "New feature or improvement" },
    { "name": "bug", "color": "d73a4a", "description": "Something is not working" },
    { "name": "duplicate", "color": "cfd3d7", "description": "Duplicate issue or PR" },
    { "name": "invalid", "color": "e4e669", "description": "Invalid or not applicable" },
    { "name": "wontfix", "color": "ffffff", "description": "Will not be addressed" }
  ],
  "legacyRemap": {
    "epic": "type:epic",
    "task": "type:task",
    "auth": "area:auth",
    "mail": "area:mail",
    "discord": "area:discord",
    "infra": "area:infra",
    "extension": "area:extension",
    "website": "area:website",
    "analytics": "area:analytics",
    "logs": "area:logs"
  }
}
