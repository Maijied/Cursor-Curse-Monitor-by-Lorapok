{
  "name": "browser-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:firefox": "npm run build",
    "build:chrome": "npm run build && node scripts/zip-chrome.mjs",
    "amo:metadata": "node scripts/generate-amo-metadata.mjs",
    "amo:publish": "node scripts/publish-amo.mjs",
    "test": "node tests/test-shared.js && node tests/test-footer.js && node tests/test-whats-new.js && node tests/test-manifest-firefox.mjs && node tests/test-amo-publish-conflict.mjs && node tests/test-auth-capture.js && node tests/test-security-scan.cjs",
    "lint": "tsc --noEmit -p ./"
  },
  "dependencies": {
    "@lorapok/cursor-monitor-shared": "file:../packages/shared",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "web-ext": "^8.3.0"
  }
}
