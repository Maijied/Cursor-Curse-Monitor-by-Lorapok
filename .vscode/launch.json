{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "compile",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "env": {
        "CCM_DEV_IDE": "cursor",
        "CCM_DEV_ROOT": "${workspaceFolder}"
      }
    }
  ]
}
